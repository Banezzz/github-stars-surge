# Discord Webhook URL (Optional)
# If unset, snapshots are still saved and the web viewer still works.
# Get from: Discord Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Database path (Optional, defaults to ./trending_history.db)
# DB_PATH=./trending_history.db

# GitHub base URL (Optional, defaults to https://github.com)
# GITHUB_BASE=https://github.com

# Schedule time for daily execution in HH:MM format (Optional, defaults to 09:00)
# SCHEDULE_TIME=09:00

# History web viewer (Optional)
# WEB_HOST=0.0.0.0
# WEB_PORT=8765

# Canonical public URL used in API docs and the JSON catalog
# PUBLIC_BASE_URL=https://ghstar.banez.de

# Extra boards: GitHub trending language slugs (empty = main board only)
# TRENDING_LANGUAGES=python,typescript,javascript,go,rust,java,c++,jupyter-notebook
# REQUEST_DELAY=1.5

# Daily star refresh via the GitHub API (token needs no scopes; raises 60/h to 5000/h)
# GITHUB_TOKEN=
# STAR_REFRESH=1
# STAR_REFRESH_DAYS=90
# STAR_REFRESH_LIMIT=

# Behind nginx/caddy: number of proxies whose X-Forwarded-* headers to trust
# TRUST_PROXY=1
